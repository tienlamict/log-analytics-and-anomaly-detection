{
  "title": "Anomaly Explorer",
  "uid": "log-explorer",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "panels": [
    {
      "id": 7,
      "title": "Anomaly Timeline",
      "description": "Detected anomalies over time grouped by rule",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 10 },
      "datasource": { "type": "elasticsearch", "uid": "elasticsearch-anomalies" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "elasticsearch-anomalies" },
          "query": "",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "rule_id.keyword",
              "id": "3",
              "settings": { "order": "desc", "orderBy": "_count", "size": "10" }
            },
            {
              "type": "date_histogram",
              "field": "detected_at",
              "id": "2",
              "settings": { "interval": "auto" }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal" }
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Anomalies",
      "description": "Detected anomalies with details",
      "type": "table",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 10 },
      "datasource": { "type": "elasticsearch", "uid": "elasticsearch-anomalies" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "elasticsearch-anomalies" },
          "query": "",
          "metrics": [{ "type": "raw_data", "id": "1", "settings": { "size": "50" } }],
          "bucketAggs": []
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "severity" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "critical": { "color": "red", "text": "CRITICAL" }, "high": { "color": "orange", "text": "HIGH" }, "medium": { "color": "yellow", "text": "MEDIUM" }, "low": { "color": "green", "text": "LOW" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "detected_at" },
            "properties": [{ "id": "unit", "value": "dateTimeAsIso" }]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "id": true, "evidence": true, "_id": true, "_type": true },
            "indexByName": {
              "detected_at": 0,
              "severity": 1,
              "rule_id": 2,
              "service": 3,
              "description": 4
            }
          }
        }
      ]
    }
  ]
}
